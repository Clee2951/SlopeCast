# Copy this file to .env and fill in what you have. Never commit .env.

# Claude hazard engine. Without it, SlopeCast uses its rule-based engine (still works).
ANTHROPIC_API_KEY=
# Only if your key is NOT scoped to a workspace (the API then answers 400 asking for anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=

# Apify weather Actor. Without it, SlopeCast calls Open-Meteo directly, then falls back to a saved series.
APIFY_TOKEN=

# Serial ports for the stakes: "auto" finds Arduinos; or list them, e.g. /dev/cu.usbmodem1101,COM4
SLOPECAST_SERIAL_PORTS=auto

# calm = simulate quiet readings for stakes N02/N03 when no hardware is plugged in for them; off = don't
SLOPECAST_EXTRA_NODES=calm

# Web server
SLOPECAST_HTTP_PORT=8000
SLOPECAST_HOST=127.0.0.1
