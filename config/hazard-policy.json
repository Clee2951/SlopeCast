{
  "version": "hazard-demo-1",
  "use_claude": true,
  "model": "claude-sonnet-5-5",
  "max_tokens": 1500,
  "timeout_s": 30,
  "min_interval_s": 20,
  "prompt_file": "config/hazard-prompt.md",
  "node_stale_after_s": 15,
  "rules": {
    "wet_index": 0.7,
    "tilt_watch_deg": 1.0,
    "tilt_alarm_deg": 4.0,
    "tilt_rate_watch_deg_per_h": 2.0,
    "tilt_rate_alarm_deg_per_h": 20.0,
    "rain_24h_watch_mm": 80,
    "forecast_24h_watch_mm": 100
  },
  "timing_fit": {
    "min_points": 8,
    "min_r2": 0.8,
    "min_velocity_deg_per_h": 2.0,
    "window_s": 900
  },
  "_notes": "All thresholds are demonstration choices, tuned so a hand-tilted stake triggers in a live demo. Not validated."
}
